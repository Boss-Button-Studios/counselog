#!/usr/bin/env bash
# Install Counselog's two services as systemd *user* units, running this
# checkout. Run it again from another checkout and the units point there
# instead — they are one per user, not one per checkout.
#
#   deploy/install-user-services            install, enable and start both
#   deploy/install-user-services --no-start install only
#
# User units stop at logout unless lingering is on:  loginctl enable-linger
set -euo pipefail

CHECKOUT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UNIT_DIR="${COUNSELOG_UNIT_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}"
# The same rule as core/paths.py. The units may write here and nowhere else.
DATA="${COUNSELOG_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/counselog}"
UNITS=(counselog-web.service counselog-desktop.service)

start=1
case "${1:-}" in
    "") ;;
    --no-start) start=0 ;;
    *) echo "usage: $0 [--no-start]" >&2; exit 2 ;;
esac

# sed treats & and | specially in a replacement; a path holding either would
# produce a unit pointing somewhere else, so refuse rather than guess.
for path in "$CHECKOUT" "$DATA"; do
    case "$path" in
        *'&'* | *'|'* | *$'\n'*) echo "Cannot install from $path: unusual characters." >&2; exit 1 ;;
    esac
done

mkdir -p "$UNIT_DIR" "$DATA"
chmod 700 "$DATA"
for unit in "${UNITS[@]}"; do
    sed -e "s|@CHECKOUT@|$CHECKOUT|g" -e "s|@DATA@|$DATA|g" \
        "$CHECKOUT/deploy/systemd/$unit" > "$UNIT_DIR/$unit"
    echo "Installed $UNIT_DIR/$unit"
done

if [ "$start" = 1 ]; then
    systemctl --user daemon-reload
    systemctl --user enable --now "${UNITS[@]}"
    systemctl --user --no-pager status "${UNITS[@]}" | grep -E "●|Active:"
fi
