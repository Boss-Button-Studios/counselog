# The desktop service: sorting, reports and the mirror, over mutual TLS.
# Installed by deploy/install-user-services, which replaces @CHECKOUT@ with the
# folder it was run from. Not used from here.
[Unit]
Description=Counselog desktop service (mutual TLS, holds no key of its own)
After=network-online.target

[Service]
ExecStart=@CHECKOUT@/counselogd
WorkingDirectory=@CHECKOUT@
# It binds the tailnet address in .env, which may not exist yet at boot, so a
# failed start is retried rather than left failed.
Restart=on-failure
RestartSec=10

# Least privilege (Guideline 4). The mirror is the only thing it writes.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA@

[Install]
WantedBy=default.target
