# Copy to .env and fill in. .env is gitignored — the repo is public, and your
# tailnet layout should not be in it.

# The name the laptop dials. Prefer the tailnet MagicDNS name over a raw IP:
# it survives an address change, and it is what the certificate is issued for.
COUNSELOG_DESKTOP_HOST=desktop.your-tailnet.ts.net

# Any addresses the desktop also answers on, comma separated. These become
# additional names on the certificate, so dialling by address still verifies.
COUNSELOG_DESKTOP_IPS=100.x.y.z

# What the desktop service listens on. Use the tailnet address, not 0.0.0.0 —
# binding everywhere would also expose the service on the local network.
COUNSELOG_BIND=100.x.y.z
COUNSELOG_PORT=8443

# How long the desktop may keep the key after the laptop hands it over, in
# seconds. It is never written to disk; this bounds how long it lives in memory.
COUNSELOG_SESSION_TTL=900

COUNSELOG_OLLAMA_URL=http://127.0.0.1:11434
