#!/usr/bin/env bash
# Counselog wrapper — the desktop service. Run from the repo root.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="${SCRIPT_DIR}/.venv/bin/python"

# Fall back to the system interpreter only if it can actually run the code.
# Falling back blindly produces a ModuleNotFoundError from deep inside an
# import chain, which tells the user nothing about what to do (Law 6).
if [ ! -x "$PYTHON" ]; then
    PYTHON=python3
fi

if ! "$PYTHON" -c 'import sqlcipher3, click, cryptography' >/dev/null 2>&1; then
    VERSION="$("$PYTHON" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || echo unknown)"
    cat >&2 <<MSG
Counselog is not set up on this machine yet.

Using: $PYTHON (Python $VERSION) — its dependencies are missing.

To set it up, from ${SCRIPT_DIR}:

    python3 -m venv .venv
    .venv/bin/pip install -e .

Then run this command again.

YubiKey support is a separate step, and only needed on a machine with a key:

    sudo apt install swig libpcsclite-dev pcscd yubikey-manager
    .venv/bin/pip install -e ".[yubikey]"

Counselog needs Python 3.12 or newer.
MSG
    exit 1
fi

PYTHONPATH="$SCRIPT_DIR" exec "$PYTHON" -m desktop "$@"
